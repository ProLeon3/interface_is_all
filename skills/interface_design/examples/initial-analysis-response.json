  "summary": "还原待办示例现状：cli 解析命令并输出，业务交给 task；task 承载待办规则，经 storage 读写；storage 做领域无关的 JSON 原子读写。两条协作均有直接调用依据。",
  "design": {
    "schema_version": 1,
    "modules": [
      {
        "id": "cli",
        "root": "cli",
        "responsibility": "解析 -file 与 add、done、list 子命令，输出结果并决定退出状态；业务操作全部交给 task。"
      },
      {
        "id": "task",
        "root": "task",
        "responsibility": "维护待办规则：标题与截止日期校验、ID 不复用、幂等完成、未完成列表排序；文件读写交给 storage。"
      },
      {
        "id": "storage",
        "root": "storage",
        "responsibility": "提供与待办无关的 JSON 文档读取与原子写入；不解释业务字段，不做多进程互斥。"
      }
    ],
    "interfaces": [
      {
        "id": "cli-command",
        "module_id": "cli",
        "name": "待办命令行入口",
        "description": "按参数执行 add、done、list 并返回退出状态（Run）。",
        "semantics": {
          "inputs": "[-file 路径] add [-due 日期] 标题 | done ID | list",
          "outputs": "每行「ID 标题 [截止日期]」；成功退出 0。",
          "errors": "参数错误或 task 报错时写 stderr 并退出 2。"
        }
      },
      {
        "id": "task-service",
        "module_id": "task",
        "name": "待办服务",
        "description": "创建、幂等完成与未完成任务查询（Add、Complete、Pending）。",
        "semantics": {
          "inputs": "数据文件路径；Add 另给标题与可选截止日期，Complete 另给 ID。",
          "outputs": "未完成任务按截止日期升序，无日期居后，同日按 ID。",
          "errors": "空标题、无效日期、任务不存在、文档损坏均报错且不写文件。"
        }
      },
      {
        "id": "storage-json-document",
        "module_id": "storage",
        "name": "JSON 文档存储",
        "description": "完整读取 JSON 文件，或用临时文件原子替换写入。",
        "semantics": {
          "inputs": "文件路径；写入时另给完整 JSON 字节。",
          "errors": "文件不存在返回 os.ErrNotExist；JSON 无效或目标已损坏则拒绝。"
        }
      }
    ],
    "forbidden_dependencies": [],
    "collaborations": [
      {
        "id": "cli-uses-task-service",
        "from": "cli",
        "interface_id": "task-service",
        "purpose": "add、done、list 分支各调用 task 的对应函数完成业务。"
      },
      {
        "id": "task-uses-storage-json-document",
        "from": "task",
        "interface_id": "storage-json-document",
        "purpose": "读文档用 ReadJSON，校验通过后用 WriteJSON 写回。"
      }
    ]
  },
